# Signora Frontend Environment Configuration
# Copy this file to .env and fill in actual values.
# Never place private API keys in VITE_ variables.
# Frontend code communicates with authorized backend APIs.

# API base URL (backend REST API)
VITE_API_BASE_URL=

# Firebase Client SDK configuration (public, required by Firebase client SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WebSocket endpoint
VITE_WS_URL=

# Application environment
VITE_APP_ENV=development
