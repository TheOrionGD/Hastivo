# MongoDB Database Configuration for Hastivo
# Replace <username>, <password>, and <cluster> with your updated credentials once available.

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hastivo?retryWrites=true&w=majority

# Database Name
MONGODB_DB_NAME=hastivo

# Connection Pool Options
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=true

