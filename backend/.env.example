PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
AI_SERVICE_URL=http://localhost:8000
CV_SERVICE_URL=http://localhost:8001
MICROSERVICE_URL=http://localhost:5002

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hastivo?retryWrites=true&w=majority

# Firebase Admin SDK Configuration (Authentication only)
FIREBASE_PROJECT_ID=patienttracker-e1c41
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@patienttracker-e1c41.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OR alternative path to service account key file:
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebaseServiceAccountKey.json

# Cloudinary Cloud Storage Configuration
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI Language Engine Configuration
GROQ_API_KEY=

# Brevo Notification Email Dispatch
BREVO_API_KEY=
